---
import ArticoloCard from './ArticoloCard.astro';
import type { Articolo } from '../lib/articoli';

interface Props {
  articoli: Articolo[];
  page: number;
  totalPages: number;
}

const { articoli, page, totalPages } = Astro.props;
const href = (n: number) => (n === 1 ? '/' : `/page/${n}/`);
---

<div class="lista">
  {articoli.map((a) => <ArticoloCard articolo={a} />)}
</div>

{
  totalPages > 1 && (
    <nav class="paginazione" aria-label="Pagine">
      {page > 1 && <a href={href(page - 1)} rel="prev">« Più recenti</a>}
      <span>
        Pagina {page} di {totalPages}
      </span>
      {page < totalPages && <a href={href(page + 1)} rel="next">Meno recenti »</a>}
    </nav>
  )
}
