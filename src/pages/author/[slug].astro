---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import Archivio from '../../components/Archivio.astro';
import { getArticoli } from '../../lib/articoli';

export const getStaticPaths = (async () => {
  const articoli = await getArticoli();
  return (await getCollection('autori'))
    .map((autore) => ({ params: { slug: autore.id }, props: { autore, articoli: articoli.filter((a) => a.data.author.id === autore.id) } }))
    .filter(({ props }) => props.articoli.length > 0);
}) satisfies GetStaticPaths;

const { autore, articoli } = Astro.props;
---

<Archivio title={`Gli articoli di ${autore.data.name}`} seoTitle={autore.data.name} articoli={articoli} />
