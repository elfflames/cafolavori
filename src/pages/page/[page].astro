---
import type { GetStaticPaths } from 'astro';
import Archivio from '../../components/Archivio.astro';
import { getArticoli, paginatePaths } from '../../lib/articoli';

// Pagine 2..N della home, con lo stesso schema di URL di WordPress (/page/2/).
export const getStaticPaths = (async () =>
  paginatePaths(await getArticoli())
    .slice(1)
    .map(({ props }) => ({ params: { page: String(props.current) }, props }))) satisfies GetStaticPaths;
---

<Archivio base="/" {...Astro.props} />
