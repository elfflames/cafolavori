---
import type { GetStaticPaths } from 'astro';
import Archivio from '../../components/Archivio.astro';
import { getArticoli, slugify, type Articolo } from '../../lib/articoli';

export const getStaticPaths = (async () => {
  const byTag = new Map<string, { name: string; articoli: Articolo[] }>();
  for (const a of await getArticoli()) {
    for (const name of a.data.tags) {
      const slug = slugify(name);
      if (!slug) continue;
      const entry = byTag.get(slug) ?? { name, articoli: [] };
      if (!entry.articoli.includes(a)) entry.articoli.push(a);
      byTag.set(slug, entry);
    }
  }
  return [...byTag].map(([slug, props]) => ({ params: { slug }, props }));
}) satisfies GetStaticPaths;

const { name, articoli } = Astro.props;
// I tag con un solo articolo sono pagine "sottili": restano navigabili ma fuori dall'indice dei motori.
---

<Archivio title={`Tag: ${name}`} articoli={articoli} noindex={articoli.length < 2} />
