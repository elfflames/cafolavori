---
import Archivio from '../components/Archivio.astro';
import { SITE } from '../consts';
import { getArticoli, paginatePaths } from '../lib/articoli';

const [first] = paginatePaths(await getArticoli());

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  alternateName: `${SITE.name} – ${SITE.tagline}`,
  url: SITE.url,
  inLanguage: SITE.lang,
  description: SITE.description,
};
---

<Archivio base="/" {...first.props} jsonLd={jsonLd} />
